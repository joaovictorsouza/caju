<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.1 (0x401000) obrigatório. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

    <!-- Sem código Java/Kotlin: a NativeActivity carrega a lib Swift. -->
    <application
        android:label="Caju"
        android:hasCode="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|density|uiMode"
            android:screenOrientation="portrait">
            <meta-data android:name="android.app.lib_name" android:value="CajuAndroidHost" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
